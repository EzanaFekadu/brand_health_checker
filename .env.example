# Supabase — persistent product cache
# Create a free project at supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# USDA FoodData Central — free, get a key at api.data.gov/signup
# Without this, falls back to DEMO_KEY (30 req/hr per IP)
VITE_USDA_API_KEY=your-usda-key

# Nutritionix — free tier at developer.nutritionix.com
VITE_NUTRITIONIX_APP_ID=your-app-id
VITE_NUTRITIONIX_APP_KEY=your-app-key
